<!doctype html>
<html lang="en"><head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nexus — ACRCY QR Board</title>
  <link rel="icon" type="image/png" href="assets/favicon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="assets/favicon-32.png">
  <link rel="apple-touch-icon" href="assets/apple-touch-icon.png">
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.263.0/dist/umd/lucide.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@600;700&family=Poppins:wght@800;900&family=Libre+Franklin:wght@700;800&family=DM+Sans:wght@500;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --maroon: #7a2331;
      --maroon-dark: #591925;
      --ink: #321119;
      --paper: #fffdfb;
      --line: #a4384b;
      --rule: #171717;
      --shadow-ink: #101010;
    }

    /* Shared design language, matching the Homepage: sharp corners, a
       hard offset shadow instead of a soft blurred one, and a small
       "lift" toward the viewer on hover/focus. .arc-action is for
       full-size buttons/links; .arc-action-sm is the same language
       scaled down for compact icon-only controls (logo badge, password
       toggle) so the shadow doesn't overpower a small element. */
    .arc-action, .arc-action-sm {
      border: 1px solid var(--rule);
      border-radius: 6px;
      transition: transform 180ms ease, box-shadow 180ms ease;
    }
    .arc-action { box-shadow: 5px 5px 0 var(--shadow-ink); }
    .arc-action:hover, .arc-action:focus-visible {
      transform: translate(-3px, -3px);
      box-shadow: 9px 9px 0 var(--shadow-ink);
    }
    .arc-action-sm { box-shadow: 3px 3px 0 var(--shadow-ink); }
    .arc-action-sm:hover, .arc-action-sm:focus-visible, .arc-action-sm:focus-within {
      transform: translate(-2px, -2px);
      box-shadow: 5px 5px 0 var(--shadow-ink);
    }

    * { box-sizing: border-box; }

    body {
      width: 100%;
      min-height: 100vh;
      margin: 0;
      overflow-x: hidden;
      color: var(--ink);
      font-family: "DM Sans", sans-serif;
      isolation: isolate;
      background: linear-gradient(rgb(5, 5, 6), rgb(23, 3, 8), rgb(5, 5, 6), rgb(42, 5, 11), rgb(3, 4, 4), rgb(22, 2, 7), rgb(5, 5, 6), rgb(33, 4, 10));
    }

    body::before {
      position: fixed;
      inset: 0;
      z-index: -1;
      content: "";
      opacity: .82;
      pointer-events: none;
      background:
        repeating-linear-gradient(90deg, transparent 0 3px, rgba(255, 20, 42, .15) 4px, transparent 6px 11px),
        linear-gradient(105deg, transparent 0 7%, rgba(208, 0, 26, .68) 12%, transparent 23% 39%, rgba(184, 0, 24, .5) 50%, transparent 64% 78%, rgba(226, 0, 31, .68) 88%, transparent 96%);
      filter: blur(1.5px);
      mix-blend-mode: screen;
    }

    .board-shell {
      width: 100%;
      min-height: 100vh;
      padding: clamp(1.2rem, 3vw, 2.6rem) clamp(1rem, 5vw, 4.4rem) 2.5rem;
    }

    .sheet {
      width: 100%;
      max-width: 1170px;
      margin: 0 auto;
      background: var(--paper);
      border: 1px solid var(--rule);
      border-radius: 6px;
      overflow: hidden;
      box-shadow: 0 22px 48px rgba(20,2,7,.16), 0 4px 10px rgba(20,2,7,.08);
      padding: clamp(1.4rem, 3vw, 2.4rem) clamp(1.2rem, 3.4vw, 2.6rem) 2rem;
      animation: enter .65s ease-out both;
    }

    @keyframes enter {
      from { opacity: 0; transform: translateY(16px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .board-header, .main-content, .board-footer {
      width: 100%;
    }

    .board-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: .9rem;
      margin-bottom: 0;
    }

    .brand-group {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: .4rem;
    }

    .brand-top {
      display: flex;
      align-items: center;
      gap: .6rem;
    }

    .brand-sub {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 3px;
      margin-left: calc(56px + .6rem);
    }

    .logo-wrap {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 56px;
      height: 56px;
      flex: 0 0 auto;
      padding: 7px;
      overflow: hidden;
      background: #fff;
    }

    .logo-wrap img { width: 100%; height: 100%; object-fit: contain; }

    .page-heading {
      min-width: 0;
      margin: 0;
      padding: 0;
      font-family: "Poppins", "DM Sans", sans-serif;
      font-weight: 900;
      font-size: 34px;
      letter-spacing: -.01em;
      line-height: 1.05;
      text-align: left;
      text-transform: uppercase;
      color: var(--maroon-dark);
    }

    .page-subtitle {
      max-width: 460px;
      margin: 0;
      padding: 0;
      color: #6c6166;
      font-size: 13px;
      font-weight: 700;
      text-align: left;
      letter-spacing: .01em;
      outline: 0;
      border-radius: 4px;
    }
    .page-subtitle[contenteditable="true"] {
      cursor: text;
      box-shadow: 0 0 0 1px rgba(122,35,49,.3);
      padding: 1px 4px;
      margin: 0 0 0 -4px;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: .55rem;
      margin-left: auto;
    }

    .icon-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      flex: 0 0 auto;
      background: #fff;
      color: var(--maroon-dark);
      cursor: pointer;
      text-decoration: none;
    }
    .icon-button svg { width: 17px; height: 17px; }

    .nav-button, .save-board-button, .add-resource-button, .tracker-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: .45rem;
      height: 42px;
      font-family: "Libre Franklin", sans-serif;
      cursor: pointer;
      text-decoration: none;
    }

    .nav-button {
      padding: 0 .9rem;
      background: #fffdf8;
      color: #07133f;
      font-weight: 800;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: .04em;
    }

    .tracker-button {
      padding: 0 .9rem;
      background: #07133f;
      color: #fff;
      font-weight: 800;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: .04em;
      border-color: #07133f !important;
    }

    .save-board-button { padding: 0 .9rem; text-transform: uppercase; letter-spacing: .04em; }

    .save-board-button:disabled, .add-resource-button:disabled { opacity: .58; cursor: not-allowed; transform: none; box-shadow: none; }
    .nav-button svg, .save-board-button svg, .add-resource-button svg, .tracker-button svg { width: 17px; height: 17px; }

    .sync-pill {
      font-size: 11px;
      font-weight: 700;
      color: #74696a;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      margin: 0;
      justify-content: flex-start;
    }
    .sync-pill.saving { color: #896414; }
    .sync-pill.error { color: #a23537; }
    .sync-pill svg { width: 13px; height: 13px; }

    .editing-note {
      max-width: 790px;
      margin: 1.2rem auto .6rem;
      color: #6c6166;
      line-height: 1.45;
      text-align: center;
    }

    .status-region {
      min-height: 1.45rem;
      margin: 0 0 1rem;
      color: #591925;
      font-size: .84rem;
      font-weight: 700;
      text-align: center;
    }

    .password-row {
      width: 100%;
      margin: .8rem 0 0;
      display: flex;
      justify-content: flex-end;
    }

    .password-widget {
      display: flex;
      align-items: center;
      margin-bottom: .5rem;
    }

    .password-toggle {
      flex: 0 0 auto;
      width: 38px;
      height: 38px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: #fff;
      color: var(--maroon-dark);
      cursor: pointer;
    }
    .password-toggle.is-unlocked { background: #27704c; border-color: #27704c !important; color: #fff; }
    .password-toggle svg { width: 17px; height: 17px; }

    .password-panel {
      width: 0;
      overflow: hidden;
      transition: width .25s ease, margin-left .25s ease;
      margin-left: 0;
    }
    .password-widget.is-open .password-panel { width: var(--pw-width, 220px); margin-left: .5rem; }

    .password-input {
      width: 100%;
      height: 38px;
      padding: 0 .8rem;
      border: 1px solid rgba(122,35,49,.35);
      border-radius: 10px;
      background: #fff;
      color: #3a1720;
      font-weight: 700;
      font-size: 13px;
      outline: 0;
      transition: box-shadow .18s ease;
    }
    .password-input:not(:placeholder-shown) {
      box-shadow: 0 0 0 3px rgba(122,35,49,.14), 0 8px 18px rgba(20,2,7,.12);
    }
    .password-input.is-wrong { animation: pw-shake .32s ease; border-color: #ff8f9a; }
    @keyframes pw-shake {
      25% { transform: translateX(-4px); }
      75% { transform: translateX(4px); }
    }

    .lock-toast {
      position: fixed;
      left: 50%;
      bottom: 24px;
      transform: translate(-50%, 12px);
      background: #2a0d13;
      color: #fff;
      padding: .6rem 1rem;
      border-radius: 10px;
      font-size: 12.5px;
      font-weight: 700;
      opacity: 0;
      pointer-events: none;
      transition: opacity .2s ease, transform .2s ease;
      z-index: 50;
      box-shadow: 0 10px 24px rgba(0,0,0,.3);
    }
    .lock-toast.is-visible { opacity: 1; transform: translate(-50%, 0); }

    [contenteditable="false"] { cursor: not-allowed; }
    input:read-only.resource-url-input { cursor: not-allowed; }
    .card-action[disabled] { opacity: .4; cursor: not-allowed; }
    .card-action[disabled]:hover { color: var(--maroon-dark); background: #fff; transform: none; }
    .add-resource-button[disabled] { opacity: .5; cursor: not-allowed; transform: none; }

    .qr-grid {
      display: grid;
      width: 100%;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.1rem, 2.7vw, 2.2rem);
    }

    .resource-item {
      min-width: 0;
      animation: rise-in .45s both;
    }

    @keyframes rise-in {
      from { opacity: 0; transform: translateY(14px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .qr-card {
      padding: clamp(.62rem, 1.2vw, .82rem);
      border: 2px solid #171717;
      border-radius: 16px;
      background: #6b101f;
      box-shadow: 0 7px 0 rgba(73,13,25,.2), 0 10px 18px rgba(46,8,16,.18);
    }

    .qr-space {
      position: relative;
      display: grid;
      width: 100%;
      aspect-ratio: 1 / 1;
      place-items: center;
      border: 2px dashed rgba(122,35,49,.68);
      border-radius: 10px;
      cursor: pointer;
      background-color: #fffdfb;
      background-image:
        radial-gradient(circle, rgba(122,35,49,.20) 1px, transparent 1.15px),
        linear-gradient(rgba(122,35,49,.055) 1px, transparent 1px),
        linear-gradient(90deg, rgba(122,35,49,.055) 1px, transparent 1px);
      background-size: 10px 10px, 20px 20px, 20px 20px;
      transition: border-color .18s ease, transform .18s ease;
    }

    .qr-space::before {
      content: "";
      position: absolute;
      inset: -10px;
      z-index: -1;
      border-radius: 16px;
      background: #fff;
      opacity: 0;
      transform: scale(.96);
      transition: opacity .22s ease, transform .22s ease;
      pointer-events: none;
      box-shadow: 0 10px 22px rgba(46,8,16,.22);
    }
    .qr-space:hover::before, .qr-space.is-dragging::before { opacity: 1; transform: scale(1); }

    .qr-space::after {
      position: absolute;
      inset: 0;
      z-index: 2;
      content: "";
      pointer-events: none;
      opacity: .3;
      background-image: radial-gradient(circle, rgba(89,25,37,.2) 1px, transparent 1.15px);
      background-size: 10px 10px;
      mix-blend-mode: multiply;
    }

    .qr-space:hover, .qr-space.is-dragging {
      border-color: var(--maroon);
      transform: translateY(-1px);
    }

    .qr-space.is-locked { cursor: not-allowed; }

    .qr-space.has-image { border-style: solid; }

    .qr-image {
      position: relative;
      z-index: 1;
      width: calc(100% - 28px);
      height: calc(100% - 28px);
      object-fit: contain;
      background: rgba(255,255,255,.78);
      transition: transform .2s ease;
    }

    .qr-space:hover .qr-image { transform: scale(1.018); }

    .upload-hint {
      position: relative;
      z-index: 3;
      max-width: 76%;
      padding: .45rem .6rem;
      border: 1px solid rgba(122,35,49,.3);
      border-radius: 7px;
      color: var(--maroon-dark);
      background: rgba(255,253,251,.9);
      font-size: .74rem;
      font-weight: 800;
      line-height: 1.3;
      text-align: center;
      pointer-events: none;
    }

    .has-image .upload-hint { display: none; }

    .resource-title, .resource-url-input {
      width: 100%;
      border: 1px solid transparent;
      outline: 0;
      font-family: "DM Sans", sans-serif;
      text-align: center;
      transition: border-color .16s ease, background .16s ease;
    }

    .resource-title {
      display: block;
      margin: .68rem 0 .28rem;
      padding: .2rem .32rem;
      color: #fdf1ee;
      background: transparent;
      font-size: clamp(.96rem, 1.45vw, 1.15rem);
      font-weight: 800;
      line-height: 1.2;
      border-radius: 6px;
    }

    .resource-title-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: .35rem;
    }
    .resource-title-row .resource-title { flex: 1; min-width: 0; margin: .68rem 0 .28rem; }

    .expand-button {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      margin-top: .3rem;
      border: 1px solid rgba(122,35,49,.36);
      border-radius: 7px;
      color: var(--maroon-dark);
      background: #fff;
      cursor: pointer;
      transition: transform .16s ease, background .16s ease, color .16s ease;
    }
    .expand-button:hover { color: #fff; background: var(--maroon); transform: translateY(-1px); }
    .expand-button svg { width: 14px; height: 14px; }

    .resource-url-input {
      display: block;
      padding: .35rem .46rem;
      border-color: rgba(122,35,49,.25);
      border-radius: 6px;
      color: #3a1720;
      background: rgba(255,255,255,.72);
      font-size: .72rem;
      font-weight: 700;
      line-height: 1.3;
    }

    .resource-title:hover, .resource-title:focus {
      color: var(--maroon-dark);
      border-color: rgba(122,35,49,.58);
      background: #fff;
    }
    .resource-url-input:hover, .resource-url-input:focus {
      border-color: rgba(122,35,49,.58);
      background: #fff;
    }

    /* When locked (view mode) a filled-in URL becomes a real clickable
       link instead of a plain text field. */
    .resource-url-input.url-clickable {
      cursor: pointer;
      color: var(--maroon);
      text-decoration: underline;
      text-decoration-style: dotted;
      text-underline-offset: 2px;
    }
    .resource-url-input.url-clickable:hover { background: #fff; }

    .action-cluster {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: .3rem;
      margin-top: .65rem;
    }

    .card-action {
      display: inline-flex;
      min-height: 32px;
      align-items: center;
      justify-content: center;
      gap: .25rem;
      padding: .35rem;
      border: 1px solid rgba(122,35,49,.36);
      border-radius: 7px;
      color: var(--maroon-dark);
      background: #fff;
      cursor: pointer;
      transition: transform .16s ease, background .16s ease, color .16s ease;
    }

    .card-action:hover {
      color: #fff;
      background: var(--maroon);
      transform: translateY(-1px);
    }

    .card-action:disabled { opacity: .5; cursor: not-allowed; transform: none; }
    .card-action svg { width: 15px; height: 15px; }
    .card-action.copied { color: #fff; background: #27704c; border-color: #27704c; }
    .card-action.delete:hover { color: #fff; background: #b91c32; }

    .add-resource-wrap { display: flex; justify-content: center; margin-top: 1.5rem; }
    .add-resource-button { padding: .74rem 1.05rem; }

    .board-footer { margin-top: 1.5rem; }
    .footer-note { margin: 0; line-height: 1.45; text-align: center; }

    .confirmation-layer {
      position: fixed;
      inset: 0;
      z-index: 20;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      background: rgba(20, 2, 7, .65);
    }

    .confirmation-layer.is-open { display: flex; }

    .confirmation-dialog {
      width: min(100%, 390px);
      padding: 1.25rem;
      border: 2px solid #9d3345;
      border-radius: 16px;
      background: #fffdfb;
      box-shadow: 0 15px 40px rgba(0,0,0,.35);
    }

    .expand-dialog { position: relative; width: min(100%, 460px); text-align: center; }
    .expand-close {
      position: absolute;
      top: .6rem;
      right: .6rem;
      width: 30px;
      height: 30px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(122,35,49,.35);
      border-radius: 7px;
      background: #fff;
      color: var(--maroon-dark);
      font-size: 20px;
      line-height: 1;
      cursor: pointer;
    }
    .expand-close:hover { background: var(--maroon); color: #fff; }
    .expand-modal-image {
      width: 100%;
      aspect-ratio: 1 / 1;
      max-height: 60vh;
      border: 2px solid #171717;
      border-radius: 10px;
      background-color: #6b101f;
      background-size: contain;
      background-position: center;
      background-repeat: no-repeat;
    }

    .confirmation-actions {
      display: flex;
      justify-content: flex-end;
      gap: .65rem;
      margin-top: 1rem;
    }

    .confirmation-actions button {
      padding: .58rem .8rem;
      border: 1px solid rgba(122,35,49,.45);
      border-radius: 8px;
      cursor: pointer;
      font: 800 .82rem "DM Sans", sans-serif;
    }

    .modal-cancel { color: #4b1b26; background: #fff; }
    .modal-delete { color: #fff; background: #a9233a; }

    button:focus-visible, input:focus-visible, [contenteditable="true"]:focus-visible, .qr-space:focus-visible {
      outline: 3px solid #e39aa4;
      outline-offset: 3px;
    }

    .expand-split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      min-height: 360px;
      max-width: 1400px;
      margin: 0 auto;
    }

    .expand-qr {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #6b101f;
      border: 2px solid #171717;
      border-radius: 10px;
      overflow: hidden;
      flex: 0 0 480px;
    }

    .expand-qr img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    .expand-qr .expand-modal-image {
      width: 100%;
      height: 100%;
      object-fit: contain;
      background: rgba(255,255,255,.78);
    }

    .expand-editor {
      display: flex;
      flex-direction: column;
      gap: .6rem;
      overflow: auto;
    }

    .expand-field {
      display: flex;
      flex-direction: column;
      gap: .2rem;
    }

    .expand-input {
      width: 100%;
      box-sizing: border-box;
      padding: .4rem .5rem;
      border: 1px solid rgba(122,35,49,.25);
      border-radius: 6px;
      color: #3a1720;
      background: #fff;
      font-family: "DM Sans", sans-serif;
      font-size: .85rem;
      font-weight: 700;
      line-height: 1.3;
    }
    .expand-input:focus {
      border-color: var(--maroon);
      outline: none;
      box-shadow: 0 0 0 3px rgba(122,35,49,.15);
    }

    .expand-rich-field { flex: 1; min-height: 0; display: flex; flex-direction: column; }

    .expand-toolbar {
      display: flex;
      align-items: center;
      gap: .2rem;
      padding: .3rem .4rem;
      border: 1px solid rgba(122,35,49,.2);
      border-radius: 6px;
      background: #fffdfb;
      margin-bottom: .3rem;
      flex-wrap: wrap;
    }

    .expand-format-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      border: 1px solid transparent;
      border-radius: 4px;
      background: transparent;
      color: var(--maroon-dark);
      cursor: pointer;
      transition: background .12s ease, color .12s ease;
    }
    .expand-format-btn:hover { background: rgba(122,35,49,.1); color: var(--maroon); }
    .expand-format-btn:active { background: rgba(122,35,49,.2); }
    .expand-format-btn svg { width: 14px; height: 14px; }
    .expand-format-btn[style*="font-weight"] { width: auto; padding: 0 .4rem; font-family: "Libre Franklin", sans-serif; }

    .expand-toolbar-divider {
      width: 1px;
      height: 20px;
      background: rgba(122,35,49,.2);
      margin: 0 .2rem;
    }

    .expand-rich {
      flex: 1;
      min-height: 140px;
      max-height: 280px;
      overflow: auto;
      padding: .5rem;
      border: 1px solid rgba(122,35,49,.2);
      border-radius: 6px;
      background: #fff;
      color: #3a1720;
      font-family: "DM Sans", sans-serif;
      font-size: .82rem;
      line-height: 1.5;
      outline: none;
    }
    .expand-rich:focus { border-color: var(--maroon); box-shadow: 0 0 0 3px rgba(122,35,49,.15); }
    .expand-rich p { margin: 0 0 .5em; }
    .expand-rich h1 { font-size: 1.5em; font-weight: 900; margin: .6em 0 .3em; color: var(--maroon-dark); }
    .expand-rich h2 { font-size: 1.25em; font-weight: 800; margin: .5em 0 .3em; color: var(--maroon-dark); }
    .expand-rich ul, .expand-rich ol { padding-left: 1.5rem; margin: .5em 0; }
    .expand-rich li { margin: .2em 0; }

    .expand-actions { display: flex; justify-content: flex-end; margin-top: .3rem; }

    .expand-save-btn {
      display: inline-flex;
      align-items: center;
      gap: .35rem;
      padding: .5rem 1rem;
      border-radius: 6px;
      font-weight: 800;
      font-size: .82rem;
      transition: transform .12s ease, box-shadow .12s ease;
    }
    .expand-save-btn svg { width: 15px; height: 15px; }

    @media (max-width: 760px) {
      .qr-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (max-width: 520px) {
      .board-header { gap: .65rem; }
      .logo-wrap { width: 48px; height: 48px; }
      .page-heading { font-size: 28px; }
      .save-board-button span, .nav-button span, .tracker-button span { display: none; }
      .qr-grid { grid-template-columns: minmax(0, 330px); justify-content: center; }
      .brand-sub { margin-left: calc(48px + .6rem); }
      .header-actions { margin-left: 0; width: 100%; justify-content: flex-end; }
    }
  </style>
 </head>
 <body>
  <main class="board-shell" aria-label="ACRCY shared resource QR board">
   <section class="sheet">
    <header class="board-header">
     <div class="brand-group">
      <div class="brand-top">
       <div class="logo-wrap arc-action-sm"><img src="assets/logo.png" alt="Ateneo College Red Cross Youth Council emblem"></div>
       <h1 class="page-heading">NEXUS</h1>
      </div>
      <div class="brand-sub">
       <p id="board-tagline" class="page-subtitle" data-template-id="tagline" contenteditable="false" spellcheck="true">Scan less, find faster — every ACRCY link and QR code, one board.</p>
       <p id="sync-pill" class="sync-pill"><i data-lucide="check-circle-2" aria-hidden="true"></i><span id="sync-pill-text">Synced</span></p>
      </div>
     </div>
     <div class="header-actions">
      <a href="index.html" class="icon-button arc-action-sm" aria-label="Home"><i data-lucide="home" aria-hidden="true"></i></a>
      <a class="nav-button arc-action" href="core.html"><i data-lucide="list-checks" aria-hidden="true"></i><span>CORE</span></a>
      <a class="tracker-button arc-action" href="https://red-cross-scheduler.vercel.app/" target="_blank" rel="noopener noreferrer"><i data-lucide="clipboard-list" aria-hidden="true"></i><span>Tracker</span></a>
      <button id="save-board-button" class="save-board-button arc-action" type="button" style="background: rgb(152, 32, 54); color: rgb(255, 255, 255); font-weight:800;font-size:13px;"><i data-lucide="save" aria-hidden="true"></i><span>Save Board</span></button>
     </div>
    </header>
    <div class="password-row">
     <div class="password-widget" id="passwordWidget">
      <button id="passwordToggle" class="password-toggle arc-action-sm" type="button" aria-expanded="false" aria-label="Unlock editing"><i data-lucide="plus" aria-hidden="true"></i></button>
      <div class="password-panel"><input id="passwordInput" type="password" class="password-input" placeholder="Input Password" autocomplete="off" spellcheck="false"></div>
     </div>
    </div>
    <section class="main-content" aria-label="QR board content">
     <p class="editing-note" style="font-weight:700;font-size:12px;letter-spacing:.04rem;">DROP A QR IMAGE ON ANY TARGET OR CLICK TO BROWSE. CLICK A TITLE OR URL TO EDIT IT, THEN USE THE CARD ACTIONS TO ORGANIZE, COPY, OR SAVE. CHANGES SAVE AUTOMATICALLY.</p>
     <p id="status-region" class="status-region" aria-live="polite"></p>
     <section id="qr-grid" class="qr-grid" aria-label="QR resource cards"></section>
     <div class="add-resource-wrap"><button id="add-resource-button" class="add-resource-button arc-action" type="button" data-requires-unlock style="background:#fff;color:#591925;font-weight:800;font-size:14px;"><i data-lucide="plus" aria-hidden="true"></i><span>Add Resource</span></button></div>
    </section>
    <footer class="board-footer">
     <p class="footer-note" style="color:#6c6166;font-weight:500;font-size:12px;">Every edit — uploads, titles, links, and order — saves to the shared board automatically.</p>
    </footer>
   </section>
  </main>

  <div id="delete-modal" class="confirmation-layer" role="presentation">
   <section class="confirmation-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title">
    <h2 id="delete-modal-title" style="color:#591925;font-weight:800;font-size:20px;margin:0;">Delete QR card?</h2>
    <p style="color:#3a1720;font-weight:700;font-size:15px;margin:.5rem 0 0;">Are you sure you want to delete this QR card?</p>
    <div class="confirmation-actions">
     <button id="delete-cancel-button" class="modal-cancel" type="button">Cancel</button>
     <button id="delete-confirm-button" class="modal-delete" type="button">Delete Card</button>
    </div>
   </section>
  </div>

  <div id="expand-modal" class="confirmation-layer" role="presentation">
   <section class="confirmation-dialog expand-dialog" role="dialog" aria-modal="true" aria-labelledby="expand-modal-title">
    <button id="expand-close-button" class="expand-close" type="button" aria-label="Close">&times;</button>
    <div class="expand-split">
      <div class="expand-qr">
        <div id="expand-modal-image" class="expand-modal-image" aria-hidden="true"></div>
      </div>
      <div class="expand-editor">
        <h2 id="expand-modal-title" style="color:#591925;font-weight:800;font-size:22px;margin:0 0 .4rem;"></h2>
        <div class="expand-field">
          <label style="display:block;font-size:.7rem;font-weight:700;color:#6c6166;text-transform:uppercase;letter-spacing:.04em;margin-bottom:.2rem;">Title</label>
          <input id="expand-title" type="text" class="expand-input" placeholder="Resource title" spellcheck="true">
        </div>
        <div class="expand-field">
          <label style="display:block;font-size:.7rem;font-weight:700;color:#6c6166;text-transform:uppercase;letter-spacing:.04em;margin-bottom:.2rem;">URL</label>
          <input id="expand-url" type="url" class="expand-input" placeholder="https://">
        </div>
        <div class="expand-field expand-rich-field">
          <label style="display:block;font-size:.7rem;font-weight:700;color:#6c6166;text-transform:uppercase;letter-spacing:.04em;margin-bottom:.3rem;">Description</label>
          <div class="expand-toolbar" role="toolbar" aria-label="Formatting">
            <button type="button" class="expand-format-btn" data-format="bold" aria-label="Bold" title="Bold (Ctrl+B)"><i data-lucide="bold" aria-hidden="true"></i></button>
            <button type="button" class="expand-format-btn" data-format="italic" aria-label="Italic" title="Italic (Ctrl+I)"><i data-lucide="italic" aria-hidden="true"></i></button>
            <button type="button" class="expand-format-btn" data-format="underline" aria-label="Underline" title="Underline (Ctrl+U)"><i data-lucide="underline" aria-hidden="true"></i></button>
            <button type="button" class="expand-format-btn" data-format="strikeThrough" aria-label="Strikethrough" title="Strikethrough"><i data-lucide="strikethrough" aria-hidden="true"></i></button>
            <span class="expand-toolbar-divider" aria-hidden="true"></span>
            <button type="button" class="expand-format-btn" data-format="insertOrderedList" aria-label="Numbered list"><i data-lucide="list-ordered" aria-hidden="true"></i></button>
            <button type="button" class="expand-format-btn" data-format="insertUnorderedList" aria-label="Bulleted list"><i data-lucide="list" aria-hidden="true"></i></button>
            <span class="expand-toolbar-divider" aria-hidden="true"></span>
            <button type="button" class="expand-format-btn" data-format="formatBlock" data-value="H1" aria-label="Heading 1" title="Heading 1" style="font-weight:800;font-size:.75rem;">H1</button>
            <button type="button" class="expand-format-btn" data-format="formatBlock" data-value="H2" aria-label="Heading 2" title="Heading 2" style="font-weight:800;font-size:.7rem;">H2</button>
          </div>
          <div id="expand-rich" class="expand-rich" contenteditable="true" spellcheck="true" style="min-height:140px;max-height:280px;overflow:auto;padding:.5rem;border:1px solid rgba(122,35,49,.2);border-radius:6px;background:#fff;color:#3a1720;font-family:'DM Sans',sans-serif;font-size:.82rem;line-height:1.5;outline:none;"></div>
        </div>
        <div class="expand-actions">
          <button id="expand-save" type="button" class="expand-save-btn arc-action" style="padding:.5rem 1rem;font-weight:800;font-size:.82rem;"><i data-lucide="download" aria-hidden="true"></i><span>Save & Export</span></button>
        </div>
      </div>
    </div>
   </section>
  </div>

  <template id="resource-template">
   <article class="resource-item">
    <div class="qr-card">
     <div class="qr-space" tabindex="0" role="button" aria-label="Upload a QR image">
      <span class="upload-hint">Drop a QR image here or click to upload</span>
      <input class="image-picker sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);" type="file" accept="image/png,image/jpeg,image/webp,image/gif">
     </div>
     <div class="resource-title-row">
      <h2 class="resource-title" contenteditable="true" spellcheck="true"></h2>
      <button class="expand-button" type="button" data-action="expand" aria-label="Expand resource"><i data-lucide="maximize-2"></i></button>
     </div>
     <input class="resource-url-input" type="url" aria-label="Resource URL" placeholder="https://">
     <div class="action-cluster" aria-label="Resource actions">
      <button class="card-action" type="button" data-action="left" data-requires-unlock aria-label="Move resource left"><i data-lucide="chevron-left"></i></button>
      <button class="card-action" type="button" data-action="right" data-requires-unlock aria-label="Move resource right"><i data-lucide="chevron-right"></i></button>
      <button class="card-action" type="button" data-action="copy" aria-label="Copy resource URL"><i data-lucide="clipboard"></i></button>
      <button class="card-action" type="button" data-action="save" aria-label="Save resource QR card"><i data-lucide="download"></i></button>
      <button class="card-action delete" type="button" data-action="delete" data-requires-unlock aria-label="Delete resource"><i data-lucide="trash-2"></i></button>
     </div>
    </div>
   </article>
  </template>

  <script>
    const API = '/api/state?app=nexus';
    const grid = document.getElementById('qr-grid');
    const statusRegion = document.getElementById('status-region');
    const addButton = document.getElementById('add-resource-button');
    const saveBoardButton = document.getElementById('save-board-button');
    const deleteModal = document.getElementById('delete-modal');
    const deleteCancel = document.getElementById('delete-cancel-button');
    const deleteConfirm = document.getElementById('delete-confirm-button');
    const expandModal = document.getElementById('expand-modal');
    const expandCloseButton = document.getElementById('expand-close-button');
    const expandModalImage = document.getElementById('expand-modal-image');
    const expandModalTitle = document.getElementById('expand-modal-title');
    const expandModalLink = document.getElementById('expand-modal-link');
    const syncPill = document.getElementById('sync-pill');
    const syncPillText = document.getElementById('sync-pill-text');

    const DEFAULT_CARDS = [
      { title: 'Emergency Contacts', url: 'https://redcross.org.ph/', image: '' },
      { title: 'Volunteer Resources', url: 'https://redcross.org.ph/volunteer-service/', image: '' },
      { title: 'ACRCY Updates', url: 'https://www.facebook.com/AteneoRedCrossYouthCouncil/', image: '' }
    ];

    let cardAwaitingDeletion = null;
    let saveTimer = null;

    // ---------- Password lock ----------
    const CORRECT_PASSWORD = 'arc143';
    let editLocked = true;

    const passwordWidget = document.getElementById('passwordWidget');
    const passwordToggle = document.getElementById('passwordToggle');
    const passwordInput = document.getElementById('passwordInput');
    const homeLink = document.querySelector('.header-actions .icon-button');
    const coreLink = document.querySelector('.header-actions .nav-button');
    const trackerLink = document.querySelector('.header-actions .tracker-button');

    function flashLockedNotice(message) {
      let toast = document.getElementById('lockToast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'lockToast';
        toast.className = 'lock-toast';
        document.body.appendChild(toast);
      }
      toast.textContent = message || 'Unlock editing to make changes.';
      toast.classList.add('is-visible');
      clearTimeout(flashLockedNotice._t);
      flashLockedNotice._t = setTimeout(() => toast.classList.remove('is-visible'), 2200);
    }

    // Applies the current lock state to one card (or any subtree). Called
    // once per card at build time and again whenever the lock toggles.
    function applyLockToRow(scope) {
      scope.querySelectorAll('[contenteditable]').forEach(el => {
        el.setAttribute('contenteditable', editLocked ? 'false' : 'true');
      });
      scope.querySelectorAll('input.resource-url-input').forEach(el => {
        el.readOnly = editLocked;
        updateUrlClickable(el);
      });
      scope.querySelectorAll('[data-requires-unlock]').forEach(el => {
        el.disabled = editLocked;
      });
      const space = scope.querySelector?.('.qr-space');
      if (space) space.classList.toggle('is-locked', editLocked);
    }

    function updateLockUI() {
      passwordToggle.classList.toggle('is-unlocked', !editLocked);
      passwordToggle.setAttribute('aria-label', editLocked ? 'Unlock editing' : 'Lock editing');
      passwordToggle.innerHTML = editLocked
        ? '<i data-lucide="plus" aria-hidden="true"></i>'
        : '<i data-lucide="unlock" aria-hidden="true"></i>';
      lucide.createIcons();
    }

    function collapsePasswordWidget() {
      passwordWidget.classList.remove('is-open');
      passwordToggle.setAttribute('aria-expanded', 'false');
      passwordInput.value = '';
      passwordInput.blur();
    }

    function openPasswordWidget() {
      const w = homeLink.offsetWidth + coreLink.offsetWidth + trackerLink.offsetWidth + saveBoardButton.offsetWidth + 22; // header-actions gap
      passwordWidget.style.setProperty('--pw-width', `${w}px`);
      passwordWidget.classList.add('is-open');
      passwordToggle.setAttribute('aria-expanded', 'true');
      passwordInput.focus({ preventScroll: true });
    }

    function setEditLocked(locked) {
      editLocked = locked;
      applyLockToRow(document);
      updateLockUI();
    }

    passwordToggle.addEventListener('click', () => {
      if (editLocked) {
        openPasswordWidget();
      } else {
        setEditLocked(true);
        collapsePasswordWidget();
        showStatus('Editing locked.');
      }
    });

    passwordInput.addEventListener('input', () => {
      if (passwordInput.value === CORRECT_PASSWORD) {
        setEditLocked(false);
        collapsePasswordWidget();
        showStatus('Editing unlocked.');
      }
    });

    passwordInput.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && passwordInput.value && passwordInput.value !== CORRECT_PASSWORD) {
        passwordInput.classList.add('is-wrong');
        setTimeout(() => passwordInput.classList.remove('is-wrong'), 350);
        passwordInput.value = '';
      }
      if (event.key === 'Escape') collapsePasswordWidget();
    });

    document.addEventListener('click', (event) => {
      if (passwordWidget.classList.contains('is-open') && !passwordWidget.contains(event.target)) {
        collapsePasswordWidget();
      }
    });

    function makeId() {
      return (crypto.randomUUID ? crypto.randomUUID() : 'id-' + Date.now() + '-' + Math.random().toString(16).slice(2));
    }

    function showStatus(message) {
      statusRegion.textContent = message;
      clearTimeout(showStatus.timer);
      showStatus.timer = setTimeout(() => { statusRegion.textContent = ''; }, 2900);
    }

    function setSyncStatus(state) {
      syncPill.classList.remove('saving', 'error');
      if (state === 'saving') {
        syncPill.classList.add('saving');
        syncPillText.textContent = 'Saving…';
      } else if (state === 'error') {
        syncPill.classList.add('error');
        syncPillText.textContent = 'Sync failed — will retry';
      } else {
        syncPillText.textContent = 'Synced';
      }
    }

    function allCards() {
      return [...grid.querySelectorAll('.resource-item')];
    }

    function getTitle(card) {
      return (card.querySelector('.resource-title')?.textContent || '').trim();
    }

    function getCardUrl(card) {
      return card.querySelector('.resource-url-input')?.value.trim() || '';
    }

    function restoreIcon(button, iconName) {
      button.innerHTML = `<i data-lucide="${iconName}" aria-hidden="true"></i>`;
      lucide.createIcons();
    }

    // ---------- Persistence: whole board is one field in /api/state ----------
    function readBoardFromDOM() {
      return allCards().map(card => ({
        id: card.dataset.cardId,
        title: getTitle(card),
        url: getCardUrl(card),
        image: card.dataset.image || ''
      }));
    }

    async function persistBoard() {
      setSyncStatus('saving');
      try {
        const board = readBoardFromDOM();
        const res = await fetch(API, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ field: 'board', value: board })
        });
        if (!res.ok) throw new Error('Save failed');
        setSyncStatus('synced');
      } catch (err) {
        console.error(err);
        setSyncStatus('error');
      }
    }

    function scheduleSave() {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(persistBoard, 700);
    }

    // ---------- Tagline (separate small field, not part of the board array) ----------
    const taglineEl = document.getElementById('board-tagline');
    let taglineSaveTimer = null;

    async function persistTagline() {
      setSyncStatus('saving');
      try {
        const res = await fetch(API, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ field: 'tagline', value: taglineEl.innerHTML })
        });
        if (!res.ok) throw new Error('Save failed');
        setSyncStatus('synced');
      } catch (err) {
        console.error(err);
        setSyncStatus('error');
      }
    }

    function scheduleTaglineSave() {
      clearTimeout(taglineSaveTimer);
      taglineSaveTimer = setTimeout(persistTagline, 700);
    }

    taglineEl.addEventListener('input', scheduleTaglineSave);
    taglineEl.addEventListener('blur', () => {
      clearTimeout(taglineSaveTimer);
      persistTagline();
    });
    taglineEl.addEventListener('mousedown', () => {
      if (editLocked) flashLockedNotice();
    });

    // ---------- Card rendering ----------
    function buildCard(record) {
      const fragment = document.getElementById('resource-template').content.cloneNode(true);
      const card = fragment.querySelector('.resource-item');
      card.dataset.cardId = record.id || makeId();
      card.querySelector('.resource-title').textContent = record.title || 'New Resource';
      card.querySelector('.resource-url-input').value = record.url || '';
      if (record.image) {
        applyImageToCard(card, record.image, { persist: false });
      }
      wireCard(card);
      applyLockToRow(card);
      return card;
    }

    function applyImageToCard(card, dataUrl, { persist = true } = {}) {
      const space = card.querySelector('.qr-space');
      let image = space.querySelector('.qr-image');
      if (!image) {
        image = document.createElement('img');
        image.className = 'qr-image';
        image.loading = 'lazy';
        image.alt = 'Uploaded QR image';
        space.prepend(image);
      }
      image.src = dataUrl;
      card.dataset.image = dataUrl;
      space.classList.add('has-image');
      if (persist) scheduleSave();
    }

    function fileToResizedDataUrl(file, maxSide = 900) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onerror = () => reject(new Error('Could not read file'));
        reader.onload = () => {
          const img = new Image();
          img.onerror = () => reject(new Error('Could not decode image'));
          img.onload = () => {
            const scale = Math.min(1, maxSide / Math.max(img.width, img.height));
            const w = Math.max(1, Math.round(img.width * scale));
            const h = Math.max(1, Math.round(img.height * scale));
            const canvas = document.createElement('canvas');
            canvas.width = w;
            canvas.height = h;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, w, h);
            ctx.drawImage(img, 0, 0, w, h);
            resolve(canvas.toDataURL('image/png'));
          };
          img.src = reader.result;
        };
        reader.readAsDataURL(file);
      });
    }

    async function attachImage(card, file) {
      if (!file || !file.type.startsWith('image/')) {
        showStatus('Please upload an image file for this QR space.');
        return;
      }
      try {
        const dataUrl = await fileToResizedDataUrl(file);
        applyImageToCard(card, dataUrl);
        showStatus('QR image uploaded and saved.');
      } catch (err) {
        console.error(err);
        showStatus('That image could not be uploaded.');
      }
    }

    function setupUploader(card) {
      const space = card.querySelector('.qr-space');
      const picker = card.querySelector('.image-picker');
      if (!space || !picker) return;

      space.addEventListener('click', () => {
        if (editLocked) { flashLockedNotice(); return; }
        picker.click();
      });
      space.addEventListener('keydown', event => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          if (editLocked) { flashLockedNotice(); return; }
          picker.click();
        }
      });

      picker.addEventListener('change', () => {
        if (editLocked) { flashLockedNotice(); return; }
        attachImage(card, picker.files[0]);
        picker.value = '';
      });

      ['dragenter', 'dragover'].forEach(type => {
        space.addEventListener(type, event => {
          event.preventDefault();
          if (editLocked) return;
          space.classList.add('is-dragging');
        });
      });

      ['dragleave', 'drop'].forEach(type => {
        space.addEventListener(type, event => {
          event.preventDefault();
          space.classList.remove('is-dragging');
        });
      });

      space.addEventListener('drop', event => {
        if (editLocked) { flashLockedNotice(); return; }
        attachImage(card, event.dataTransfer.files[0]);
      });
    }

    // html2canvas 1.4.1 has the same limitation with layered
    // backgrounds that it does with `object-fit` and `aspect-ratio`
    // (see the fixes below): the reverted `.qr-space` dotted design
    // uses THREE comma-separated background-image layers (a dot grid +
    // two line grids), and html2canvas drops that stack silently,
    // exporting a blank square instead. The fix is the same pattern
    // already used for the QR image itself — bake the look into a
    // single flattened image (here, one small tiling SVG) that
    // html2canvas can actually rasterize.
    let qrSpacePatternUri = null;
    function qrSpaceBackgroundDataUri() {
      if (qrSpacePatternUri) return qrSpacePatternUri;
      const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20">
        <rect width="20" height="20" fill="#fffdfb"/>
        <rect width="20" height="20" fill="none" stroke="rgba(122,35,49,0.16)" stroke-width="1"/>
        <circle cx="5" cy="5" r="1.1" fill="rgba(122,35,49,0.32)"/>
        <circle cx="15" cy="5" r="1.1" fill="rgba(122,35,49,0.32)"/>
        <circle cx="5" cy="15" r="1.1" fill="rgba(122,35,49,0.32)"/>
        <circle cx="15" cy="15" r="1.1" fill="rgba(122,35,49,0.32)"/>
      </svg>`;
      qrSpacePatternUri = `data:image/svg+xml,${encodeURIComponent(svg)}`;
      return qrSpacePatternUri;
    }

    // Applies that flattened pattern to a cloned `.qr-space` in place of
    // its live (unsupported) layered background.
    function flattenQrSpaceBackground(space) {
      if (!space) return;
      space.style.backgroundImage = `url("${qrSpaceBackgroundDataUri()}")`;
      space.style.backgroundSize = '20px 20px';
      space.style.backgroundRepeat = 'repeat';
      space.style.backgroundColor = '#fffdfb';
    }

    // Adds "https://" to a bare domain/path so window.open() actually
    // navigates instead of treating it as a relative link on this site.
    function normalizeUrl(raw) {
      const value = (raw || '').trim();
      if (!value) return '';
      return /^https?:\/\//i.test(value) ? value : `https://${value}`;
    }

    // Toggles the underline/pointer-cursor treatment that signals a
    // filled-in URL field is clickable — only while editing is locked,
    // so unlocking still gives a plain, focusable text field to edit.
    function updateUrlClickable(input) {
      input.classList.toggle('url-clickable', editLocked && !!input.value.trim());
    }

    function wireCard(card) {
      setupUploader(card);

      card.querySelectorAll('[data-action]').forEach(button => {
        button.addEventListener('click', () => handleAction(card, button));
      });

      const title = card.querySelector('.resource-title');
      const url = card.querySelector('.resource-url-input');
      if (title) title.addEventListener('blur', scheduleSave);
      if (url) {
        url.addEventListener('change', scheduleSave);
        url.addEventListener('input', () => updateUrlClickable(url));
        url.addEventListener('click', event => {
          if (!editLocked || !url.value.trim()) return;
          event.preventDefault();
          window.open(normalizeUrl(url.value), '_blank', 'noopener,noreferrer');
        });
        updateUrlClickable(url);
      }
    }

    async function copyText(text) {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
        return;
      }
      const helper = document.createElement('textarea');
      helper.value = text;
      helper.style.position = 'fixed';
      helper.style.opacity = '0';
      document.body.appendChild(helper);
      helper.select();
      document.execCommand('copy');
      helper.remove();
    }

    async function handleAction(card, button) {
      const action = button.dataset.action;

      if (action === 'left' || action === 'right') {
        if (editLocked) { flashLockedNotice(); return; }
        const cards = allCards();
        const index = cards.indexOf(card);
        const sibling = action === 'left' ? cards[index - 1] : cards[index + 1];
        if (!sibling) {
          showStatus(action === 'left' ? 'This card is already first.' : 'This card is already last.');
          return;
        }
        if (action === 'left') grid.insertBefore(card, sibling);
        else grid.insertBefore(sibling, card);
        scheduleSave();
        showStatus('Card order updated.');
        return;
      }

      if (action === 'expand') {
        openExpandEditor(card);
        return;
      }

      if (action === 'copy') {
        const url = getCardUrl(card);
        if (!url) {
          showStatus('Add a URL before copying this resource.');
          return;
        }
        try {
          await copyText(url);
          button.classList.add('copied');
          restoreIcon(button, 'check');
          showStatus('URL copied to clipboard.');
          setTimeout(() => {
            if (button.isConnected) {
              button.classList.remove('copied');
              restoreIcon(button, 'clipboard');
            }
          }, 1800);
        } catch (err) {
          console.error(err);
          showStatus('Could not copy the URL in this browser.');
        }
        return;
      }

      if (action === 'save') {
        const image = card.querySelector('.qr-image');
        if (!image || !card.dataset.image) {
          showStatus('Upload a QR image before saving this card.');
          return;
        }

        // Measure the live layout before html2canvas touches anything —
        // html2canvas 1.4.1 doesn't understand the CSS `aspect-ratio`
        // property, so the QR square was collapsing/resizing in its
        // clone, which is what pushed the title/url out of frame. Pinning
        // the real, already-rendered pixel size sidesteps that entirely.
        const liveSpace = card.querySelector('.qr-space');
        const spaceRect = liveSpace.getBoundingClientRect();

        button.disabled = true;
        try {
          const canvas = await html2canvas(card.querySelector('.qr-card'), {
            backgroundColor: null,
            scale: 2,
            useCORS: true,
            imageTimeout: 15000,
            onclone: (clonedDoc, el) => {
              el.querySelectorAll('.action-cluster, .expand-button').forEach(n => n.style.display = 'none');

              const clonedSpace = el.querySelector('.qr-space');
              if (clonedSpace) {
                clonedSpace.style.aspectRatio = 'auto';
                clonedSpace.style.width = `${spaceRect.width}px`;
                clonedSpace.style.height = `${spaceRect.height}px`;
                flattenQrSpaceBackground(clonedSpace);
              }

              // html2canvas also doesn't honor `object-fit` on <img> —
              // it stretches the QR to fill the box instead of keeping
              // its ratio. A div with background-size:contain gets the
              // same visual result and IS respected by html2canvas.
              const clonedImg = el.querySelector('.qr-image');
              if (clonedImg) {
                const bg = clonedDoc.createElement('div');
                bg.className = clonedImg.className;
                bg.style.backgroundImage = `url("${clonedImg.src}")`;
                bg.style.backgroundSize = 'contain';
                bg.style.backgroundPosition = 'center';
                bg.style.backgroundRepeat = 'no-repeat';
                clonedImg.replaceWith(bg);
              }

              // html2canvas doesn't reliably rasterize form-field values —
              // swap the title/url editable fields for plain text so both
              // are guaranteed to actually show up in the exported PNG.
              el.querySelectorAll('.resource-title').forEach(n => {
                n.style.border = '1px solid transparent';
              });
              el.querySelectorAll('.resource-url-input').forEach(n => {
                const span = clonedDoc.createElement('div');
                span.textContent = n.value || 'No link added';
                // Fix vertical alignment: measure live input height and apply explicitly
                const liveInput = document.querySelector('.resource-url-input');
                const inputH = liveInput ? liveInput.getBoundingClientRect().height : 24;
                span.style.cssText = `
                  display: block;
                  box-sizing: border-box;
                  width: 100%;
                  height: ${inputH}px;
                  line-height: ${inputH}px;
                  padding: 0 .46rem;
                  border: 1px solid transparent;
                  border-radius: 6px;
                  color: #3a1720;
                  background: rgba(255,255,255,.72);
                  font-family: "DM Sans", sans-serif;
                  font-size: .72rem;
                  font-weight: 700;
                  text-align: center;
                  white-space: nowrap;
                  overflow: hidden;
                  text-overflow: ellipsis;
                `;
                n.replaceWith(span);
              });
            }
          });
          const link = document.createElement('a');
          link.href = canvas.toDataURL('image/png');
          link.download = `${(getTitle(card) || 'qr-card').replace(/[^a-z0-9]+/gi, '-').toLowerCase()}.png`;
          link.click();
          showStatus('QR card saved as PNG.');
        } catch (err) {
          console.error(err);
          showStatus('Could not export this card — try saving the raw image instead.');
        }
        button.disabled = false;
        return;
      }

      if (action === 'delete') {
        if (editLocked) { flashLockedNotice(); return; }
        cardAwaitingDeletion = card;
        deleteModal.classList.add('is-open');
        // preventScroll stops the browser from jumping the page to bring
        // the (already-visible, fixed-position) button into view right
        // after it goes from display:none to visible in the same tick.
        deleteCancel.focus({ preventScroll: true });
      }
    }

    function closeDeleteModal() {
      cardAwaitingDeletion = null;
      deleteModal.classList.remove('is-open');
    }

    function deleteSelectedCard() {
      if (!cardAwaitingDeletion) return;
      cardAwaitingDeletion.remove();
      closeDeleteModal();
      scheduleSave();
      showStatus('QR card removed.');
    }

    addButton.addEventListener('click', () => {
      if (editLocked) { flashLockedNotice(); return; }
      const card = buildCard({ id: makeId(), title: 'New Resource', url: '', image: '' });
      grid.appendChild(card);
      lucide.createIcons();
      applyLockToRow(card);
      scheduleSave();
      showStatus('New QR resource card added.');
      card.querySelector('.resource-title').focus({ preventScroll: true });
    });

    saveBoardButton.addEventListener('click', async () => {
      saveBoardButton.disabled = true;
      await persistBoard();

      // Export the whole board as one shareable PNG.
      try {
        // Measure every card's live QR square before cloning — same
        // aspect-ratio workaround as the per-card save (see comment
        // there), just applied across all cards at once.
        const spaceRects = allCards().map(c => {
          const space = c.querySelector('.qr-space');
          return space ? space.getBoundingClientRect() : null;
        });

        const canvas = await html2canvas(document.querySelector('.board-shell'), {
          backgroundColor: '#0a0203',
          scale: 2,
          useCORS: true,
          imageTimeout: 15000,
          onclone: (clonedDoc, el) => {
            el.querySelectorAll('.header-actions, .password-row, .add-resource-wrap, .status-region, .action-cluster, .expand-button').forEach(n => {
              n.style.display = 'none';
            });

            el.querySelectorAll('.qr-space').forEach((space, i) => {
              const rect = spaceRects[i];
              if (rect) {
                space.style.aspectRatio = 'auto';
                space.style.width = `${rect.width}px`;
                space.style.height = `${rect.height}px`;
              }
              flattenQrSpaceBackground(space);
            });

            el.querySelectorAll('.qr-image').forEach(img => {
              const bg = clonedDoc.createElement('div');
              bg.className = img.className;
              bg.style.backgroundImage = `url("${img.src}")`;
              bg.style.backgroundSize = 'contain';
              bg.style.backgroundPosition = 'center';
              bg.style.backgroundRepeat = 'no-repeat';
              img.replaceWith(bg);
            });

            el.querySelectorAll('.resource-url-input').forEach(n => {
              const span = clonedDoc.createElement('div');
              span.textContent = n.value || 'No link added';
              const liveInput = document.querySelector('.resource-url-input');
              const inputH = liveInput ? liveInput.getBoundingClientRect().height : 24;
              span.style.cssText = `
                display: block;
                box-sizing: border-box;
                width: 100%;
                height: ${inputH}px;
                line-height: ${inputH}px;
                padding: 0 .46rem;
                border: 1px solid transparent;
                border-radius: 6px;
                color: #3a1720;
                background: rgba(255,255,255,.72);
                font-family: "DM Sans", sans-serif;
                font-size: .72rem;
                font-weight: 700;
                text-align: center;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
              `;
              n.replaceWith(span);
            });
          }
        });
        const link = document.createElement('a');
        link.href = canvas.toDataURL('image/png');
        link.download = 'acrcy-nexus-board.png';
        link.click();
        showStatus('Board saved and exported as PNG.');
      } catch (err) {
        console.error(err);
        showStatus('Board saved, but the PNG export failed in this browser.');
      }
      saveBoardButton.disabled = false;
    });

    deleteCancel.addEventListener('click', closeDeleteModal);
    deleteConfirm.addEventListener('click', deleteSelectedCard);
    deleteModal.addEventListener('click', event => {
      if (event.target === deleteModal) closeDeleteModal();
    });

    function closeExpandModal() { expandModal.classList.remove('is-open'); }
    expandCloseButton.addEventListener('click', closeExpandModal);
    expandModal.addEventListener('click', event => {
      if (event.target === expandModal) closeExpandModal();
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && deleteModal.classList.contains('is-open')) closeDeleteModal();
      if (event.key === 'Escape' && expandModal.classList.contains('is-open')) closeExpandModal();
    });

    // -------- Expanded Editor Functionality --------
    let expandCurrentCard = null;

    function openExpandEditor(card) {
      expandCurrentCard = card;
      const image = card.dataset.image;
      expandModalImage.style.backgroundImage = image ? `url("${image}")` : 'none';
      expandModalImage.src = image || '';
      const title = card.querySelector('.resource-title')?.textContent.trim() || '';
      const url = getCardUrl(card);
      const rich = card.dataset.rich || '';
      document.getElementById('expand-title').value = title;
      document.getElementById('expand-url').value = url;
      document.getElementById('expand-rich').innerHTML = rich || '';
      expandModal.classList.add('is-open');
      document.getElementById('expand-title').focus({ preventScroll: true });
    }

    function closeExpandEditor() {
      if (expandCurrentCard) {
        // Persist changes back to card
        expandCurrentCard.querySelector('.resource-title').textContent = document.getElementById('expand-title').value.trim() || 'New Resource';
        expandCurrentCard.querySelector('.resource-url-input').value = document.getElementById('expand-url').value.trim();
        expandCurrentCard.dataset.rich = document.getElementById('expand-rich').innerHTML;
        updateUrlClickable(expandCurrentCard.querySelector('.resource-url-input'));
        scheduleSave();
      }
      expandCurrentCard = null;
      expandModal.classList.remove('is-open');
    }

    // Toolbar format commands
    const EXPAND_FORMAT_COMMANDS = ['bold', 'italic', 'underline', 'strikeThrough', 'insertOrderedList', 'insertUnorderedList'];
    document.querySelectorAll('.expand-format-btn[data-format]').forEach(btn => {
      btn.addEventListener('mousedown', e => e.preventDefault()); // keep selection
      btn.addEventListener('click', () => {
        const format = btn.dataset.format;
        const value = btn.dataset.value;
        if (format === 'formatBlock' && value) {
          document.execCommand('formatBlock', false, value);
        } else if (EXPAND_FORMAT_COMMANDS.includes(format)) {
          document.execCommand(format, false, null);
        }
        document.getElementById('expand-rich').focus();
      });
    });

    // Keep toolbar focused on rich editor
    document.getElementById('expand-rich').addEventListener('focus', () => {
      expandCurrentCard = expandCurrentCard; // no-op, just reference
    });

    // Save & Export expanded view
    document.getElementById('expand-save').addEventListener('click', async () => {
      if (!expandCurrentCard) return;
      const btn = document.getElementById('expand-save');
      btn.disabled = true;
      try {
        // Persist current editor state to card first
        expandCurrentCard.querySelector('.resource-title').textContent = document.getElementById('expand-title').value.trim() || 'New Resource';
        expandCurrentCard.querySelector('.resource-url-input').value = document.getElementById('expand-url').value.trim();
        expandCurrentCard.dataset.rich = document.getElementById('expand-rich').innerHTML;
        updateUrlClickable(expandCurrentCard.querySelector('.resource-url-input'));
        scheduleSave();

        // Measure live QR square for aspect-ratio fix
        const liveSpace = expandCurrentCard.querySelector('.qr-space');
        const spaceRect = liveSpace ? liveSpace.getBoundingClientRect() : null;

        btn.disabled = true;
        btn.style.opacity = '0.7';

        const canvas = await html2canvas(expandCurrentCard.querySelector('.qr-card'), {
          backgroundColor: null,
          scale: 2,
          useCORS: true,
          imageTimeout: 15000,
          onclone: (clonedDoc, el) => {
            el.querySelectorAll('.action-cluster, .expand-button').forEach(n => n.style.display = 'none');

            const clonedSpace = el.querySelector('.qr-space');
            if (clonedSpace && spaceRect) {
              clonedSpace.style.aspectRatio = 'auto';
              clonedSpace.style.width = `${spaceRect.width}px`;
              clonedSpace.style.height = `${spaceRect.height}px`;
              flattenQrSpaceBackground(clonedSpace);
            }

            const clonedImg = el.querySelector('.qr-image');
            if (clonedImg) {
              const bg = clonedDoc.createElement('div');
              bg.className = clonedImg.className;
              bg.style.backgroundImage = `url("${clonedImg.src}")`;
              bg.style.backgroundSize = 'contain';
              bg.style.backgroundPosition = 'center';
              bg.style.backgroundRepeat = 'no-repeat';
              clonedImg.replaceWith(bg);
            }

            // Replace title/url with styled divs
            el.querySelectorAll('.resource-title').forEach(n => { n.style.border = '1px solid transparent'; });
            el.querySelectorAll('.resource-url-input').forEach(n => {
              const span = clonedDoc.createElement('div');
              span.textContent = n.value || 'No link added';
              // Fix URL vertical alignment: measure live input height and apply explicitly
              const liveInput = document.querySelector('.resource-url-input'); // any input works for measurement
              const inputH = liveInput ? liveInput.getBoundingClientRect().height : 24;
              span.style.cssText = `
                display: block;
                box-sizing: border-box;
                width: 100%;
                height: ${inputH}px;
                line-height: ${inputH}px;
                padding: 0 .46rem;
                border: 1px solid transparent;
                border-radius: 6px;
                color: #3a1720;
                background: rgba(255,255,255,.72);
                font-family: "DM Sans", sans-serif;
                font-size: .72rem;
                font-weight: 700;
                text-align: center;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
              `;
              n.replaceWith(span);
            });

            // Replace rich editor content with styled div
            el.querySelectorAll('.expand-rich').forEach(n => {
              const div = clonedDoc.createElement('div');
              div.innerHTML = n.innerHTML;
              div.style.cssText = `
                display: block;
                width: 100%;
                padding: .5rem;
                color: #3a1720;
                font-family: "DM Sans", sans-serif;
                font-size: .82rem;
                line-height: 1.5;
              `;
              n.replaceWith(div);
            });

            // Hide editor chrome
            el.querySelectorAll('.expand-field, .expand-toolbar, .expand-actions').forEach(n => n.style.display = 'none');
          }
        });

        const link = document.createElement('a');
        link.href = canvas.toDataURL('image/png');
        link.download = `${(document.getElementById('expand-title').value || 'resource').replace(/[^a-z0-9]+/gi, '-').toLowerCase()}.png`;
        link.click();
        showStatus('Expanded resource saved as PNG.');
        closeExpandEditor();
      } catch (err) {
        console.error(err);
        showStatus('Could not export expanded resource.');
      } finally {
        btn.disabled = false;
        btn.style.opacity = '1';
      }
    });

    // Sync editor fields on input (for live preview)
    document.getElementById('expand-title').addEventListener('input', () => {
      if (expandCurrentCard) expandCurrentCard.querySelector('.resource-title').textContent = document.getElementById('expand-title').value;
    });
    document.getElementById('expand-url').addEventListener('input', () => {
      if (expandCurrentCard) {
        expandCurrentCard.querySelector('.resource-url-input').value = document.getElementById('expand-url').value;
        updateUrlClickable(expandCurrentCard.querySelector('.resource-url-input'));
      }
    });
    document.getElementById('expand-rich').addEventListener('input', () => {
      if (expandCurrentCard) expandCurrentCard.dataset.rich = document.getElementById('expand-rich').innerHTML;
    });

    // Also update the original expand action to use the new editor
    const originalExpandHandler = handleAction;
    // We'll patch the expand action in handleAction below

    async function loadBoard() {
      try {
        const res = await fetch(API);
        if (!res.ok) throw new Error('Load failed');
        const data = await res.json();
        const board = Array.isArray(data.board) && data.board.length ? data.board : DEFAULT_CARDS;
        grid.innerHTML = '';
        board.forEach(record => grid.appendChild(buildCard(record)));
        if (typeof data.tagline === 'string' && document.activeElement !== taglineEl) {
          taglineEl.innerHTML = data.tagline;
        }
        lucide.createIcons();
        setSyncStatus('synced');
        if (!Array.isArray(data.board) || !data.board.length) {
          // First-ever load: persist the defaults so they stick around.
          persistBoard();
        }
      } catch (err) {
        console.error(err);
        grid.innerHTML = '';
        DEFAULT_CARDS.forEach(record => grid.appendChild(buildCard({ ...record, id: makeId() })));
        lucide.createIcons();
        setSyncStatus('error');
        showStatus('Could not reach the shared board — showing local defaults.');
      }
    }

    loadBoard();
    applyLockToRow(document);
    updateLockUI();
    lucide.createIcons();
  </script>
 </body>
</html>
